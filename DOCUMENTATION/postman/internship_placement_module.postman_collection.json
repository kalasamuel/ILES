{
  "info": {
    "name": "ILES - Internship Placement Module API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0",
    "description": "API endpoints for internship placement management (create placement, upload documents, approve/reject, workflow history)."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "adminEmail", "value": "admin@gmail.com" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "accessToken", "value": "REPLACE_WITH_TOKEN_FROM_LOGIN" },
    { "key": "placementId", "value": "REPLACE_WITH_PLACEMENT_UUID" },
    { "key": "documentId", "value": "REPLACE_WITH_DOCUMENT_UUID" }
  ],
  "item": [
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accounts/users/login/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "accounts", "users", "login", ""]
        }
      },
      "response": [
        {
          "name": "Admin Login Success",
          "originalRequest": {},
          "status": "OK",
          "code": 200,
          "body": "{\n  \"refresh\": \"<refresh_token>\",\n  \"access\": \"<access_token>\",\n  \"user\": {\n    \"user_id\": \"admin-uuid\",\n    \"email\": \"admin@gmail.com\",\n    \"first_name\": \"Admin\",\n    \"last_name\": \"User\",\n    \"role\": \"Administrator\"\n  }\n}"
        }
      ]
    },
