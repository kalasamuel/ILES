    {
      "name": "Upload Placement Document",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "placement", "value": "placement-uuid", "type": "text" },
            { "key": "document_type", "value": "acceptance_letter", "type": "text" },
            { "key": "file_url", "src": "<path-to-your-file>", "type": "file" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/placements/documents/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "placements", "documents", ""]
        }
      },
      "response": [
